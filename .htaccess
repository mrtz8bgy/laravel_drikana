<IfModule mod_rewrite.c>
RewriteEngine On

# Redirect only the project root so the browser visibly uses /public/.
# Capture the URL path from the request; never derive it from the filesystem.
RewriteCond %{REQUEST_URI} ^(.*)/$
RewriteRule ^$ %1/public/ [R=302,L,NE]

# Laravel handles all requests below the public document root.
RewriteRule ^public(?:/|$) - [L]
RewriteRule ^(.*)$ public/$1 [L]
</IfModule>