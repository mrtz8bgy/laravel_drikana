# =====================================================================
# دریکانا — نمونه فایل متغیرهای محیطی
# =====================================================================
#
# این فایل هیچ مقدار واقعی یا محرمانه‌ای ندارد و تنها نقش الگو دارد.
#
# نحوه استفاده:
#   1) این فایل را به .env کپی کنید:
#          cp .env.example .env
#   2) مقادیر زیر را با مقادیر واقعی محیط خود پر کنید.
#   3) کلید برنامه را بسازید:
#          php artisan key:generate
#
# ⚠ هشدار امنیتی:
#   • فایل .env هرگز نباید در Git ذخیره شود (در .gitignore ثبت شده است).
#   • هیچ رمز، کلید API یا توکن واقعی را داخل این فایل نمونه نگذارید.
#   • در سرور production مقدار APP_DEBUG باید false باشد.
#   • تمام مقادیری که در نسخه‌های قبلی پروژه در Git لو رفته‌اند
#     (APP_KEY، رمز دیتابیس، کلیدهای درگاه پرداخت، پیامک و شبکه‌های
#     اجتماعی) باید باطل و از نو ساخته شوند. فهرست کامل در
#     docs/security-audit.md آمده است.
# =====================================================================

# ---------------------------------------------------------------------
# برنامه
# ---------------------------------------------------------------------
APP_NAME=Drikana
APP_ENV=local
APP_KEY=
# در محیط production این مقدار باید حتماً false باشد؛ در غیر این صورت
# جزئیات داخلی برنامه (مسیرها، کوئری‌ها، متغیرهای محیطی) به کاربر نمایش
# داده می‌شود.
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=Asia/Tehran
APP_LOCALE=fa

# ---------------------------------------------------------------------
# زبان و حالت‌های نمایشی
# ---------------------------------------------------------------------
DEFAULT_LANGUAGE=fa
DEMO_MODE=false

# ⚠ خطر امنیتی: اگر SHOW_DEBUG_OTP یا DEBUG_OTP_CODE فعال باشند،
# کد یک‌بارمصرف در پاسخ API نمایش داده می‌شود. این گزینه‌ها فقط
# برای محیط توسعه مجاز هستند و در production باید خالی/غیرفعال باشند.
SHOW_DEBUG_OTP=false
DEBUG_OTP_CODE=

# ---------------------------------------------------------------------
# لاگ
# ---------------------------------------------------------------------
LOG_CHANNEL=stack

# ---------------------------------------------------------------------
# دیتابیس (مقادیر نمونه — مقدار واقعی را خودتان تعیین کنید)
# ---------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=drikana
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------------
# کش / صف / نشست
# ---------------------------------------------------------------------
BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ---------------------------------------------------------------------
# Redis (اختیاری)
# ---------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------
# ایمیل
# ---------------------------------------------------------------------
MAIL_DRIVER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

MAILGUN_DOMAIN=
MAILGUN_SECRET=

# ---------------------------------------------------------------------
# پیام‌رسان ابری
# ---------------------------------------------------------------------
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ---------------------------------------------------------------------
# درگاه‌های پرداخت — همه مقادیر باید از پنل درگاه گرفته شوند
# ---------------------------------------------------------------------
# زرین‌پال (ایران)
ZARINPAL_MERCHANT_CODE=

# پی‌پینگ (ایران)
IM_API_KEY=
IM_AUTH_TOKEN=

# ملت / سایر درگاه‌های داخلی
VOGUE_MERCHANT_ID=

# Paystack (بین‌المللی)
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Paytm (هند)
PAYTM_ENVIRONMENT=local
PAYTM_MERCHANT_ID=
PAYTM_MERCHANT_KEY=
PAYTM_MERCHANT_WEBSITE=DEFAULT
PAYTM_INDUSTRY_TYPE=Retail
PAYTM_CHANNEL=WEB

# Razorpay
RAZOR_KEY=
RAZOR_SECRET=

# SSLCommerz
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWD=

# ---------------------------------------------------------------------
# پیامک — ملی‌پیامک و فراز اس‌ام‌اس
# ---------------------------------------------------------------------
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_PATTERN_ID=

FARAZSMS_USERNAME=
FARAZSMS_PASSWORD=
FARAZSMS_FROM=
FARAZSMS_PATTERN_ID=

# ---------------------------------------------------------------------
# Google Tag Manager / Analytics
# ---------------------------------------------------------------------
# ⚠ شناسه TRACKING_ID پیش‌تر در Git لو رفته بود؛ شناسه جدید بسازید.
TRACKING_ID=

# ---------------------------------------------------------------------
# ورود با شبکه‌های اجتماعی
# ⚠ همه این کلیدها پیش‌تر در Git لو رفته بودند و باید باطل شوند.
# ---------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PIXEL_ID=
